---
import { getCollection } from 'astro:content';
import { chapters, parts } from '../data/book-map';
import {summarizeCoverage} from '../lib/coverage-summary.js';
import {routeForChapter} from '../lib/learning-catalog';
import sourceInventory from '../data/book-sections.json';
const { number } = Astro.props;
const chapter = chapters.find((item) => item.number === number);
if (!chapter) throw new Error(`Unknown chapter: ${number}`);
const part = parts.find((item) => item.id === chapter.part);
const entries = await getCollection('docs');
const concepts = entries.filter((entry) => entry.data.kind === 'concept' && entry.data.chapter === number).sort((a,b) => a.data.title.localeCompare(b.data.title));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sourceObjectives = sourceInventory.sections.filter(section => section.chapter === number && section.coverageUnit);
const summary=summarizeCoverage(sourceInventory.sections,number);
const route=routeForChapter(number);
---

<div class={`chapter-intro part-${chapter.part}`}>
  <span class="eyebrow">Part {part?.number} · Chapter {String(number).padStart(2, '0')}</span>
  <p>{chapter.summary}</p>
  <a href={`${base}parts/${chapter.part}/`}>← Back to {part?.shortTitle}</a>
</div>

<section class="chapter-section">
  <div class="section-heading"><span class="eyebrow">Concepts to explore</span><h2>Start with the essentials</h2></div>
  {concepts.length > 0 ? <div class="concept-card-grid">
    {concepts.map((entry) => <a class="concept-card" href={`${base}concepts/${entry.data.conceptId}/`}>
      <span class="concept-card-kind">Concept lesson</span><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><span class="text-arrow">Read the lesson →</span>
    </a>)}
  </div> : <p class="quiet-note">Concept notes for this chapter are being developed. Use the topic map below as a reading guide.</p>}
</section>

<section class="chapter-section" id="source-objectives" aria-label="Source objective coverage">
 <span class="eyebrow">Audited source inventory</span><h2>Source objectives and evidence</h2>
 <p>{summary.mapped} of {summary.total} leaf objectives mapped · {summary.accepted} independently accepted · {summary.executed} of {summary.practical} required practical objectives have recorded execution.</p>
 <p>Mapping is navigation, acceptance is independent teaching review, and execution applies only to a recorded configuration. <a href={base+'coverage/'}>Understand these counts</a>.</p>
 <details><summary>Inspect the objectives, gaps and destinations</summary><ul>{sourceObjectives.map(section=><li><strong>{section.title}</strong> · printed pp. {section.printedPages.join('–')}<p>Review: {section.reviewStatus}. Practical execution: {section.requirements.implementation?section.realModelExecution:'not required for this objective'}.</p><ul>{section.mappings.map(m=><li><a href={`${base}${m.path.replace('src/content/docs/','').replace('.mdx','/')}#${m.anchor}`}>{m.conceptId??'Lesson section'}</a></li>)}</ul>{section.mappings.length===0&&<p>Destination still to implement.</p>}<details><summary>Remaining review work</summary><ul>{section.gaps.map(g=><li>{g}</li>)}</ul>{'executionRecord'in section&&<a href={'https://github.com/shadril238/llm-concept-atlas/blob/main/'+section.executionRecord}>Recorded execution</a>}</details></li>)}</ul></details>
</section>
{route&&<section class="learning-next"><h2>Use this chapter</h2><nav class="learning-actions"><a href={base+route.pathHref}>Guided path</a><a href={base+route.labHref}>Connected lab</a><a href={base+route.projectHref}>Project</a></nav></section>}

<div class="source-note">This is an independent study guide. For the full treatment and runnable chapter notebook, see <em>Hands-On Large Language Models</em> and the <a href={`https://github.com/HandsOnLLM/Hands-On-Large-Language-Models/tree/main/chapter${String(number).padStart(2, '0')}`}>authors' official code</a>.</div>
