---
import DiscoveryPanel from './DiscoveryPanel.astro';
import { getCollection } from 'astro:content';
const entries=(await getCollection('docs')).filter(e=>e.data.kind==='concept');
const base=import.meta.env.BASE_URL.replace(/\/?$/,'/');
---
<DiscoveryPanel id="directory" mode="concept" />
<noscript><ul>{entries.map(e=><li><a href={`${base}concepts/${e.data.conceptId}/`}>{e.data.title}</a></li>)}</ul></noscript>
