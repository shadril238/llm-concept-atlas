---
import { parts, chapters, chapterSlug } from '../data/book-map';
const { id } = Astro.props;
const part = parts.find((item) => item.id === id);
if (!part) throw new Error(`Unknown part: ${id}`);
const matching = chapters.filter((chapter) => chapter.part === id);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class={`part-intro part-${id}`}>
  <span class="eyebrow">Book pathway · Part {part.number}</span>
  <p>{part.summary}</p>
  <div class="part-progress"><span>{matching.length} chapters</span><span>Read in any order, or follow the sequence below.</span></div>
</div>

<div class="chapter-card-grid">
  {matching.map((chapter) => <a class="chapter-card" href={`${base}${chapterSlug(chapter)}/`}>
    <span class="chapter-number">{String(chapter.number).padStart(2, '0')}</span>
    <div><h2>{chapter.title}</h2><p>{chapter.summary}</p><small>{chapter.topics.length} mapped topic areas</small></div>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>)}
</div>
