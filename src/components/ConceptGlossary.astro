---
import DiscoveryPanel from './DiscoveryPanel.astro';
import {getCollection} from 'astro:content';
import {enrichConcept} from '../lib/learning-catalog';
const entries=(await getCollection('docs')).filter(e=>e.data.kind==='concept').map(e=>enrichConcept(e.data)).sort((a,b)=>a.title.localeCompare(b.title,'en'));
const base=import.meta.env.BASE_URL.replace(/\/?$/,'/');
---
<p>Every definition points to one canonical lesson. Search by abbreviation, alternate spelling or task, then open its connected lab or learning path.</p>
<DiscoveryPanel id="glossary" mode="concept" />
<noscript><dl>{entries.map(e=><div><dt><a href={`${base}concepts/${e.conceptId}/`}>{e.title}</a></dt><dd>{e.summary}<p>Also known as: {e.aliases.join(' · ')}</p></dd></div>)}</dl></noscript>
