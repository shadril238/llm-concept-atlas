---
import { getCollection } from 'astro:content';
const entries=(await getCollection('docs')).filter(entry=>entry.data.kind==='concept').sort((a,b)=>a.data.title.localeCompare(b.data.title));
const base=import.meta.env.BASE_URL.replace(/\/?$/,'/');
---
<div class="concept-glossary">
  <p>Aliases point to a canonical lesson. Definitions and source locations live on that lesson; alternate spellings do not create competing pages.</p>
  <dl>{entries.map(entry=><div><dt><a href={`${base}concepts/${entry.data.conceptId}/`}>{entry.data.title}</a></dt><dd>{entry.data.summary}{entry.data.aliases.length>0&&<p><small>Also search: {entry.data.aliases.join(' · ')}</small></p>}</dd></div>)}</dl>
</div>
