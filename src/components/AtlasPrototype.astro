---
import { getAtlasGraph, type AtlasNode } from '../lib/atlas';
import { parts, chapters } from '../data/book-map';
const graph = await getAtlasGraph();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const url = (path: string) => base + path.replace(/^\/+/, '');
const concepts = graph.nodes.filter((node) => node.kind === 'concept');
const getNode = (id: string): AtlasNode => {
  const node = graph.nodes.find((item) => item.id === id);
  if (!node) throw new Error(`Missing atlas route node: ${id}`);
  return node;
};
const exemplarPaths = [
  ['token', 'tokenization', 'vocabulary', 'token-embedding'],
  ['token-embedding', 'transformer', 'attention', 'self-attention'],
  ['text-embedding', 'semantic-search', 'rag'],
];
---

<div class="atlas-intro">
  <span class="eyebrow">The concept map</span>
  <p>Start at a book part, move into a chapter, then follow a concept. The connecting paths below show how ideas build on one another.</p>
  <div class="atlas-counts"><span><strong>{parts.length}</strong> parts</span><span><strong>{chapters.length}</strong> chapters</span><span><strong>{concepts.length}</strong> concept notes</span></div>
</div>

<section class="atlas-tree" aria-label="Part, chapter, and concept hierarchy">
  {parts.map((part) => <div class={`atlas-lane part-${part.id}`}>
    <a class="atlas-part" href={url(`parts/${part.id}/`)}><span>PART {part.number}</span><strong>{part.shortTitle}</strong><small>{part.summary}</small></a>
    <div class="atlas-chapters">
      {chapters.filter((chapter) => chapter.part === part.id).map((chapter) => {
        const chapterConcepts = concepts.filter((node) => node.chapter === chapter.number);
        return <div class="atlas-chapter">
          <a class="atlas-chapter-title" href={url(`/chapters/${part.id}/${String(chapter.number).padStart(2, '0')}/`)}><b>{String(chapter.number).padStart(2, '0')}</b><span>{chapter.title}</span><i aria-hidden="true">↗</i></a>
          {chapterConcepts.length > 0 && <div class="atlas-concepts">{chapterConcepts.map((node) => <a href={url(node.href)} title={node.summary}><span class="node-dot"></span><span>{node.title}</span>{node.parent?.startsWith('chapter-') ? '' : <small>↳ {graph.nodes.find((item) => item.id === node.parent)?.title}</small>}</a>)}</div>}
          {chapterConcepts.length === 0 && <div class="atlas-empty">Chapter overview and topic outline</div>}
        </div>;
      })}
    </div>
  </div>)}
</section>

<section class="atlas-routes" aria-labelledby="atlas-route-title"><div class="section-heading"><span class="eyebrow">Follow a connection</span><h2 id="atlas-route-title">Three routes through the map</h2><p>These arrows show prerequisite order. The chapter lanes above show the parent–child hierarchy.</p></div>
  {exemplarPaths.map((path, index) => <div class="route-trace"><span class="trace-number">0{index + 1}</span><div>{path.map((id, position) => { const node = getNode(id); return <><a href={url(node.href)}>{node.title}</a>{position < path.length - 1 && <span aria-hidden="true">→</span>}</>; })}</div></div>)}
</section>

<div class="atlas-legend"><span><i class="legend-parent"></i> Part → chapter → concept: contains</span><span><i class="legend-prereq"></i> Arrowed route: learn before</span><span><i class="legend-related"></i> Concept notes also link related ideas</span></div>
