{
  "name": "llm-concept-atlas",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:graph": "node --test tests/graph.test.mjs",
    "test:content": "node --test tests/content.test.mjs",
    "test:coverage": "node --test tests/coverage.test.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "coverage:report": "node scripts/check-coverage.mjs --write",
    "check:examples": "node scripts/check-code-examples.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "release:build": "npm run test:graph && npm run test:content && npm run test:coverage && npm run check:coverage && npm run check:example-manifest && npm run test:examples && npm run test:reference && npm run test:foundations && npm run test:workflows && npm run test:discovery && npm run test:retrieval && npm run test:training && npm run test:generation && npm run check:examples && npm run check && npm run build && npm run check:links",
    "check:example-manifest": "node scripts/check-example-manifest.mjs",
    "examples:sync": "python3 scripts/sync-examples.py",
    "examples:list": "python3 scripts/run-examples.py --list",
    "test:examples": "python3 -m unittest discover -s tests/examples -v",
    "test:reference": "node --test tests/reference-mechanics.test.mjs",
    "test:foundations": "node --test tests/foundation-mechanics.test.mjs",
    "test:discovery": "node --test tests/discovery-mechanics.test.mjs",
    "test:workflows": "node --test tests/workflow-mechanics.test.mjs",
    "test:retrieval": "node --test tests/retrieval-mechanics.test.mjs",
    "test:training": "node --test tests/training-mechanics.test.mjs",
    "test:generation": "node --test tests/generation-mechanics.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "@astrojs/starlight": "^0.42.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.6",
    "cytoscape": "3.34.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
